# Google AI Studio Gemini API Key (Optional: system includes intelligent domain fallback)
GEMINI_API_KEY=

# CRM Webhook Endpoint (e.g. LeadSquared, Salesforce, Sterco CRM)
CRM_WEBHOOK_URL=https://httpbin.org/post
ENABLE_CRM_DISPATCH=true

# Security & Compliance
DPDP_COMPLIANCE_ENABLED=true
COOKIE_CONSENT_REQUIRED=true

# Server Ports
PORT=3000
BACKEND_PORT=8000
